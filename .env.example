# Copy to .env (gitignored) and fill in locally. Never commit .env or paste keys into chat.

# Deployer wallet (DecentAgency.eth is fine). It needs a little Base ETH for gas and
# gets NO powers in the contract: fee recipient and owner are constructor arguments.
# If this is the DecentAgency.eth key, clear it from .env right after deploying.
DEPLOYER_PRIVATE_KEY=

# Steward-confirmed DecentAgency.eth address (re-resolved and compared before signing).
DCAL_FEE_RECIPIENT=0xcAeEd8422fB5682C298B7F0971906d446fFd4e7a
# Token-allowlist owner; defaults to DCAL_FEE_RECIPIENT.
DCAL_OWNER=

DCAL_DEPLOY_RPC=https://mainnet.base.org
DCAL_ENS_RPC=https://ethereum-rpc.publicnode.com

# Optional: Etherscan API v2 key (works for Basescan) to publish verified source.
ETHERSCAN_API_KEY=
